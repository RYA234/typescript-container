{
  "name": "ecs-sample-node",
  "version": "1.0.0",
  "main": "dist/src/app.js",
  "scripts": {
    "build": "tsc && npm run build:phaser && npm run copy-views",
    "build:phaser": "esbuild src/phaser/client/index.ts --bundle --outfile=src/phaser/views/game.js --platform=browser",
    "copy-views": "node -e \"const fs=require('fs');fs.cpSync('src/index/views','dist/src/index/views',{recursive:true});fs.cpSync('src/chatbot/views','dist/src/chatbot/views',{recursive:true});fs.cpSync('src/rag/company-rules/views','dist/src/rag/company-rules/views',{recursive:true});fs.cpSync('src/phaser/views','dist/src/phaser/views',{recursive:true})\"",
    "start": "node dist/src/app.js",
    "dev": "ts-node src/app.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.86.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.27.4",
    "jest": "^30.2.0",
    "phaser": "^3.90.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
